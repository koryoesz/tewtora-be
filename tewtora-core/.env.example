APP_NAME="Tewtora Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# The Next.js app — email links (e.g. the welcome email's dashboard button) point here.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=auth
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Emails go on the `mail` queue — run a worker with `--queue=mail,default`
# (`composer dev` does this locally). `database` works with no extra setup;
# `redis` needs the phpredis extension and a running Redis.
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Shared broker for cross-service outbox events — see docker-compose.yml
# at the repo root (not this project's own), and outbox:relay.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=tewtora
RABBITMQ_PASSWORD=tewtora
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=tewtora.events

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Set MAIL_MAILER=resend in staging/production. MAIL_FROM_ADDRESS must be on a
# domain verified in the Resend dashboard, or Resend rejects the send.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Tewtora"
RESEND_API_KEY=
# Resend's per-team API limit; every queued email shares this budget.
RESEND_RATE_LIMIT_PER_SECOND=2

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
